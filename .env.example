# Notionの内部インテグレーションのトークン。サーバー限定。読み取り権限のみ。
NOTION_TOKEN=
# Study Logのdata source ID。空欄時は確認済みのStudy Logを使用。
NOTION_DATA_SOURCE_ID=
# 任意のプロパティID対応JSON。title,date,subject,duration,unitを指定。
NOTION_PROPERTY_IDS=
# Google OAuthウェブアプリのクライアントID。
GOOGLE_CLIENT_ID=
# Google OAuthクライアントシークレット。サーバー限定。
GOOGLE_CLIENT_SECRET=
# 十分な長さのランダムなセッション暗号化用秘密値。
NEXTAUTH_SECRET=
# このアプリの正規URL。開発時はlocalhostのポート3000。
NEXTAUTH_URL=
# アクセスを許可する本人のGoogleメールアドレス。カンマ区切り、完全一致。
ALLOWED_EMAILS=
# Node/Docker配置時の永続ボリューム絶対パス。Vercelでは使用せずRedisを設定。
CACHE_DIR=
# Vercel用共有キャッシュのHTTPS REST URL。Upstash互換。
UPSTASH_REDIS_REST_URL=
# 共有キャッシュの書き込み可能なRESTトークン。サーバー限定。
UPSTASH_REDIS_REST_TOKEN=
# 任意。ローカル画面テストでインストール済みChromeを使う場合にchromeを指定。
PLAYWRIGHT_CHANNEL=
