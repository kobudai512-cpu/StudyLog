# Notionの内部インテグレーションのトークン。サーバー限定。読み取り権限のみ。
NOTION_TOKEN=
# Study Logのdata source ID。空欄時は確認済みのStudy Logを使用。
NOTION_DATA_SOURCE_ID=
# 任意のプロパティID対応JSON。title,date,subject,duration,unit,materialを指定。
NOTION_PROPERTY_IDS=
# 任意。週の目標のdata source ID。空欄時はこのワークスペースの確認済みIDを使用。
NOTION_GOALS_DATA_SOURCE_ID=
# 任意。週目標のプロパティID対応JSON。week,target,memoを指定。
NOTION_GOALS_PROPERTY_IDS=
# Google OAuthウェブアプリのクライアントID。
GOOGLE_CLIENT_ID=
# Google OAuthクライアントシークレット。サーバー限定。
GOOGLE_CLIENT_SECRET=
# 十分な長さのランダムなセッション暗号化用秘密値。
NEXTAUTH_SECRET=
# このアプリの正規URL。開発時はlocalhostのポート3000。
NEXTAUTH_URL=
# アクセスを許可する本人のGoogleメールアドレス。カンマ区切り、完全一致。
ALLOWED_EMAILS=
# Node/Docker配置時の永続ボリューム絶対パス。Vercelでは使用せずRedisを設定。
CACHE_DIR=
# Vercel用共有キャッシュのHTTPS REST URL。Upstash互換。
UPSTASH_REDIS_REST_URL=
# 共有キャッシュの書き込み可能なRESTトークン。サーバー限定。
UPSTASH_REDIS_REST_TOKEN=
# 任意。ローカル画面テストでインストール済みChromeを使う場合にchromeを指定。
PLAYWRIGHT_CHANNEL=

# Notionへの記録作成・週目標の作成と更新を有効化する場合のみtrue。未設定時は無効。
NOTION_WRITE_ENABLED=
# 任意。Study Logと週の目標に共有した保存用接続のトークン。未設定時はNOTION_TOKEN。
NOTION_WRITE_TOKEN=
